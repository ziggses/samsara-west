    _text: "\u6D1E\u95E8\u6B7B\u5B88"
  - _key: enc.ch01.boss.desc
    _text: "\u4E0D\u53EF\u9003\u8DD1\u7684\u4E00\u6218\uFF1A\u6DF7\u4E16\u9B54\u738B\u4E0D\u80AF\u8BA4\u8F93\u3002"
