  - _key: dlg.ch01.009.desc
    _text: "\u7B2C\u4E00\u5E74\u653E\u6843\u4E09\u767E\u516D\u5341\u4E94\u9897\uFF0C\u672B\u9875\u5199\u7740\u4E0D\u53EF\u6362\u65B0\u6843\u3002"
