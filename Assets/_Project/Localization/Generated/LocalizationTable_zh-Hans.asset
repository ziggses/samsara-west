  - _key: dlg.ch01.010.name
    _text: "\u516C\u5F00\u8D26\u672C"
  - _key: dlg.ch01.011.desc
    _text: "\u6811\u6839\u4E0B\u7684\u7B2C\u4E00\u5757\u6728\u724C\uFF0C\u523B\u7740\u516B\u5E74\u524D\u7684\u4ECA\u5929\u3002"
  - _key: dlg.ch01.011.line.1
    _text: "\u6843\u6811\u6839\u4E0B\u57CB\u7740\u4E00\u5757\u6728\u724C\uFF0C\u724C\u4E0A\u523B\u7740\u65E5\u671F\uFF1A\u516B\u5E74\u524D\u7684\u4ECA\u5929\u3002"
  - _key: dlg.ch01.011.line.2
    _text: "\u6728\u724C\u5E95\u4E0B\u8FD8\u538B\u7740\u4E00\u5757\uFF0C\u57CB\u5F97\u6BD4\u6811\u6839\u6D45\u3002"
  - _key: dlg.ch01.011.name
    _text: "\u6843\u6811\u6728\u724C\xB7\u4E00"
  - _key: dlg.ch01.012.desc
    _text: "\u65E5\u671F\u66F4\u65E9\u7684\u7B2C\u4E8C\u5757\u6728\u724C\uFF0C\u523B\u75D5\u5374\u662F\u4E00\u6A21\u4E00\u6837\u7684\u3002"
  - _key: dlg.ch01.012.line.1
    _text: "\u7B2C\u4E8C\u5757\u6728\u724C\u4E0A\u7684\u65E5\u671F\u6BD4\u7B2C\u4E00\u5757\u65E9\u3002"
  - _key: dlg.ch01.012.line.2
    _text: "\u5B57\u662F\u540C\u4E00\u4E2A\u4EBA\u523B\u7684\uFF0C\u8FDE\u523B\u6B6A\u7684\u5730\u65B9\u90FD\u4E00\u6837\u3002"
  - _key: dlg.ch01.012.name
    _text: "\u6843\u6811\u6728\u724C\xB7\u4E8C"
  - _key: dlg.ch01.013.desc
    _text: "\u57CB\u5F97\u6700\u6DF1\u7684\u4E00\u5757\uFF0C\u98CE\u4E00\u5439\u5C31\u8F6C\u5411\u5317\u3002"
  - _key: dlg.ch01.013.line.1
    _text: "\u7B2C\u4E09\u5757\u6728\u724C\u57CB\u5F97\u6700\u6DF1\uFF0C\u65E5\u671F\u4E5F\u662F\u516B\u5E74\u524D\u3002"
  - _key: dlg.ch01.013.line.2
    _text: "\u98CE\u4E00\u5439\uFF0C\u724C\u5B50\u8F6C\u4E86\u4E00\u4E0B\uFF0C\u724C\u9762\u671D\u5317\u3002"
  - _key: dlg.ch01.013.line.3
    _text: "\u8FD9\u4E9B\u724C\u5B50\u5728\u6307\u8DEF\uFF1F"
  - _key: dlg.ch01.013.line.3.who
    _text: "\u963F\u7384"
  - _key: dlg.ch01.013.name
    _text: "\u6843\u6811\u6728\u724C\xB7\u4E09"
  - _key: dlg.ch01.014.desc
    _text: "\u77F3\u684C\u5E95\u4E0B\u90A3\u672C\u8D26\u672C\uFF0C\u7EB8\u9875\u88AB\u6843\u6C41\u6CE1\u5F97\u53D1\u786C\u3002"
  - _key: dlg.ch01.014.line.1
    _text: "\u77F3\u684C\u5E95\u4E0B\u538B\u7740\u4E00\u672C\u8D26\u672C\uFF0C\u7EB8\u9875\u88AB\u6843\u6C41\u6CE1\u5F97\u53D1\u786C\u3002"
  - _key: dlg.ch01.014.line.2
    _text: "\u7B2C\u4E00\u5E74\u5171\u653E\u6843\u4E09\u767E\u516D\u5341\u4E94\u9897\u3002\u7B2C\u4E8C\u5E74\u4ECD\u5728\u653E\u540C\u4E00\u6279\u3002"
  - _key: dlg.ch01.014.line.2.who
    _text: "\u963F\u7384"
  - _key: dlg.ch01.014.line.3
    _text: "\u672B\u9875\u53EA\u6709\u4E00\u884C\uFF1A\u4E0D\u53EF\u6362\u65B0\u6843\uFF0C\u5426\u5219\u5927\u5723\u8BA4\u4E0D\u5F97\u5BB6\u3002"
