    _text: "\u9ED1\u98CE\u5BE8\u4E3B"
  - _key: enemy.banquet_monkey.desc
    _text: "\u5B88\u7740\u957F\u684C\u7684\u7334\u5996\uFF0C\u4F1A\u7ED9\u540C\u4F34\u656C\u9152\u56DE\u8840\uFF0C\u4E94\u884C\u5C5E\u571F\u3002"
  - _key: enemy.banquet_monkey.name
    _text: "\u5BB4\u793C\u7334"
  - _key: enemy.drunk_monkey.desc
    _text: "\u62B1\u7740\u9152\u575B\u7684\u7334\u5996\uFF0C\u6325\u62F3\u65F6\u811A\u6B65\u865A\u6D6E\uFF0C\u4E94\u884C\u5C5E\u571F\u3002"
  - _key: enemy.drunk_monkey.name
    _text: "\u9189\u7334\u5996"
  - _key: enemy.monkey_grunt.desc
    _text: "\u9B54\u738B\u6D1E\u95E8\u524D\u6700\u666E\u901A\u7684\u5B88\u536B\uFF0C\u4E94\u884C\u5C5E\u571F\u3002"
  - _key: enemy.monkey_grunt.name
    _text: "\u7334\u5996\u55BD\u5570"
  - _key: enemy.monkey_king.desc
    _text: "\u4E94\u767E\u5E74\u6267\u5FF5\u51DD\u6210\u7684\u4E00\u76F8\uFF0C\u56DB\u4E2A\u9636\u6BB5\u5404\u6709\u5404\u7684\u4E0D\u80AF\u8BA4\u8F93\u3002"
  - _key: enemy.monkey_king.name
    _text: "\u6DF7\u4E16\u9B54\u738B\xB7\u6267\u5FF5\u76F8"
  - _key: enemy.mountain_ape.desc
    _text: "\u82B1\u679C\u5C71\u6DF1\u5904\u7684\u51F6\u517D\uFF0C\u4E00\u7838\u4E4B\u4E0B\u788E\u77F3\u4E71\u98DE\uFF0C\u4E94\u884C\u5C5E\u571F\u3002"
  - _key: enemy.mountain_ape.name
    _text: "\u5C71\u9B48"
  - _key: enemy.nameless_bone.desc
    _text: "\u5893\u7891\u4E0B\u7684\u65E7\u9AA8\uFF0C\u4E0D\u4E3B\u52A8\u4F24\u4EBA\uFF0C\u53EA\u5728\u6709\u4EBA\u56DE\u5E94\u65F6\u56DE\u54CD\u3002"
  - _key: enemy.nameless_bone.name
    _text: "\u65E0\u540D\u7334\u9AA8"
  - _key: enemy.rotten_peach.desc
    _text: "\u4ECE\u70C2\u6843\u91CC\u751F\u51FA\u6765\u7684\u5996\u7269\uFF0C\u6563\u51FA\u7684\u751C\u8150\u4E4B\u6C14\u8BA9\u4EBA\u624B\u811A\u53D1\u8F6F\uFF0C\u4E94\u884C\u5C5E\u6728\u3002"
