    _text: "\u7ED3\u5C40\xB7\u672A\u7ADF"
  - _key: ending.default.title
    _text: "\u672A\u7ADF\u4E4B\u8DEF"
  - _key: ending.mercy.desc
    _text: "\u4F60\u653E\u8FC7\u4E86\u592A\u591A\u4EBA\u3002"
  - _key: ending.mercy.epilogue
    _text: "\u5BE8\u4E2D\u8001\u5C0F\u66FF\u4F60\u7ACB\u4E86\u957F\u751F\u724C\u4F4D\u3002"
  - _key: ending.mercy.name
    _text: "\u7ED3\u5C40\xB7\u6148\u60B2"
  - _key: ending.mercy.title
    _text: "\u6148\u822A\u666E\u5EA6"
  - _key: ending.true.desc
    _text: "\u4E09\u5FF5\u4FF1\u5168\uFF0C\u65B9\u89C1\u771F\u7AE0\u3002"
  - _key: ending.true.epilogue
    _text: "\u539F\u6765\u96BE\u7684\u4E0D\u662F\u5C71\uFF0C\u662F\u4EBA\u5FC3\u3002"
  - _key: ending.true.name
    _text: "\u7ED3\u5C40\xB7\u7B2C\u516B\u5341\u4E8C\u96BE"
  - _key: ending.true.title
    _text: "\u7B2C\u516B\u5341\u4E8C\u96BE"
  - _key: ending.truth.desc
    _text: "\u4F60\u542C\u89C1\u4E86\u4E0D\u8BE5\u542C\u89C1\u7684\u8BDD\u3002"
  - _key: ending.truth.epilogue
    _text: "\u53D6\u56DE\u7684\u771F\u7ECF\u5C11\u4E86\u4E00\u9875\uFF0C\u800C\u90A3\u4E00\u9875\u5728\u4F60\u624B\u91CC\u3002"
  - _key: ending.truth.name
    _text: "\u7ED3\u5C40\xB7\u771F\u76F8"
  - _key: ending.truth.title
    _text: "\u7ECF\u91CC\u6709\u8C0E"
  - _key: enemy.bandit.desc
    _text: "\u62E6\u8DEF\u8BA8\u94B1\u7684\u5C0F\u5352\uFF0C\u4E94\u884C\u5C5E\u6728\u3002"
