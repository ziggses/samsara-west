    _text: "\u963F\u7384"
  - _key: dlg.ch01.014.name
    _text: "\u65E7\u77F3\u684C"
  - _key: dlg.ch01.015.desc
    _text: "\u6728\u724C\u4E0A\u5199\u7740\u4ECA\u65E5\u5927\u738B\u8D62\u4E86\uFF0C\u4E0B\u9762\u4E00\u884C\u88AB\u722A\u75D5\u522E\u6389\u3002"
  - _key: dlg.ch01.015.line.1
    _text: "\u85E4\u6839\u7F20\u7740\u4E00\u5757\u65E7\u6728\u724C\u3002"
  - _key: dlg.ch01.015.line.2
    _text: "\u6728\u724C\u4E0A\u5199\u7740\uFF1A\u4ECA\u65E5\u5927\u738B\u8D62\u4E86\u3002"
  - _key: dlg.ch01.015.line.3
    _text: "\u4E0B\u65B9\u8FD8\u6709\u4E00\u884C\u88AB\u722A\u75D5\u522E\u6389\u7684\u5B57\uFF1A\u5927\u738B\u6CA1\u6709\u56DE\u6765\u3002"
  - _key: dlg.ch01.015.name
    _text: "\u65AD\u6865\u85E4\u6839"
  - _key: dlg.ch01.016.desc
    _text: "\u73AF\u662F\u65E7\u7684\uFF0C\u7891\u662F\u65B0\u7684\u3002"
