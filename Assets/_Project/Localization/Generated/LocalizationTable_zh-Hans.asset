  - _key: enc.ch01.001.desc
    _text: "\u4E24\u540D\u9189\u7334\u5996\u6321\u5728\u9053\u4E0A\uFF0C\u77F3\u7334\u6295\u624B\u5728\u540E\u5934\u63B7\u77F3\u3002"
  - _key: enc.ch01.001.name
    _text: "\u524D\u5C71\u62E6\u8DEF"
  - _key: enc.ch01.002.desc
    _text: "\u8150\u6843\u5996\u6563\u51FA\u7684\u751C\u6C14\u91CC\uFF0C\u85E4\u8513\u7CBE\u5DF2\u7ECF\u7F20\u4E0A\u4E86\u811A\u8E1D\u3002"
  - _key: enc.ch01.002.name
    _text: "\u70C2\u6843\u6797"
  - _key: enc.ch01.003.desc
    _text: "\u85E4\u8513\u7CBE\u5C01\u4F4F\u65AD\u6865\uFF0C\u5C71\u9B48\u4ECE\u6865\u5934\u538B\u8FC7\u6765\u3002"
  - _key: enc.ch01.003.name
    _text: "\u65AD\u6865\u85E4\u8513"
  - _key: enc.ch01.004.desc
    _text: "\u957F\u684C\u88AB\u6380\u7FFB\uFF0C\u5BB4\u793C\u7334\u4E0E\u6295\u624B\u4E00\u8D77\u538B\u4E86\u4E0A\u6765\u3002"
  - _key: enc.ch01.004.name
    _text: "\u5BB4\u573A\u4E71\u6597"
  - _key: enc.ch01.005.desc
    _text: "\u9B54\u738B\u6D1E\u95E8\u524D\u7684\u6700\u540E\u4E00\u961F\u5B88\u536B\u3002"
