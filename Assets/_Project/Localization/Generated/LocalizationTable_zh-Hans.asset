    _text: "\u5C71\u8D3C\u55BD\u5570"
  - _key: enemy.bandit_archer.desc
    _text: "\u8EB2\u5728\u540E\u9762\u7684\u51B7\u7BAD\u624B\uFF0C\u4E94\u884C\u5C5E\u91D1\u3002"
  - _key: enemy.bandit_archer.name
    _text: "\u5C71\u8D3C\u5F13\u624B"
  - _key: enemy.bandit_leader.desc
    _text: "\u7B2C\u4E5D\u7AE0\u4E4B\u5916\u7684\u7B2C\u516B\u5341\u4E8C\u96BE\uFF0C\u7531\u6B64\u4EBA\u8D77\u3002"
