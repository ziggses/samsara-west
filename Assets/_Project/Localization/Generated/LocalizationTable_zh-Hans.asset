    _text: "\u9B54\u738B\u4E4B\u96BE"
  - _key: enc.ch01.hidden.desc
    _text: "\u4E09\u5177\u65E0\u540D\u7334\u9AA8\u62E6\u5728\u7891\u524D\uFF0C\u5B83\u4EEC\u53EA\u60F3\u88AB\u542C\u89C1\u3002"
  - _key: enc.ch01.hidden.name
    _text: "\u65E0\u540D\u7334\u9AA8"
  - _key: ending.default.desc
    _text: "\u4EC0\u4E48\u4E5F\u6CA1\u6539\u53D8\uFF0C\u8DEF\u8FD8\u957F\u7740\u3002"
  - _key: ending.default.epilogue
    _text: "\u5E08\u5F92\u56DB\u4EBA\u7EE7\u7EED\u5411\u897F\uFF0C\u9ED1\u98CE\u5CAD\u7684\u4E8B\u65E0\u4EBA\u518D\u63D0\u3002"
